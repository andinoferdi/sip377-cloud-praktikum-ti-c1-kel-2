{
	"info": {
		"name": "API Contract Simple v1 - Praktik Komputasi Awan",
		"description": "Collection resmi mengikuti UI Contract (Versi A - GAS).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Modul 01 - Presensi QR",
			"item": [
				{
					"name": "POST Generate QR",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
									"var json = pm.response.json();",
									"pm.test(\"Response is successful\", function () { pm.expect(json.ok).to.be.true; });",
									"if(json.data && json.data.qr_token) { pm.environment.set(\"qr_token\", json.data.qr_token); }"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "text/plain" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"course_id\": \"{{course_id}}\",\n  \"session_id\": \"{{session_id}}\",\n  \"ts\": \"2026-03-03T10:00:00Z\"\n}"
						},
						"url": {
							"raw": "https://script.google.com/macros/s/AKfycbzwGB2egCMblZrIQUQJketAhlABHr5jde6JoBAwdY6RhiuLlcs3Wzm1C71cQykB-awqEw/exec/presence/qr/generate",
							"protocol": "https",
							"host": [ "script", "google", "com" ],
							"path": [ "macros", "s", "AKfycbzwGB2egCMblZrIQUQJketAhlABHr5jde6JoBAwdY6RhiuLlcs3Wzm1C71cQykB-awqEw", "exec", "presence", "qr", "generate" ]
						}
					}
				},
				{
					"name": "POST Check-in",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "text/plain" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_id\": \"{{mahasiswa_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"course_id\": \"{{course_id}}\",\n  \"session_id\": \"{{session_id}}\",\n  \"qr_token\": \"{{qr_token}}\",\n  \"ts\": \"2026-03-03T10:05:00Z\"\n}"
						},
						"url": {
							"raw": "https://script.google.com/macros/s/AKfycbzwGB2egCMblZrIQUQJketAhlABHr5jde6JoBAwdY6RhiuLlcs3Wzm1C71cQykB-awqEw/exec/presence/checkin",
							"protocol": "https",
							"host": [ "script", "google", "com" ],
							"path": [ "macros", "s", "AKfycbzwGB2egCMblZrIQUQJketAhlABHr5jde6JoBAwdY6RhiuLlcs3Wzm1C71cQykB-awqEw", "exec", "presence", "checkin" ]
						}
					}
				},
				{
					"name": "GET Status Presensi",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://script.google.com/macros/s/AKfycbzwGB2egCMblZrIQUQJketAhlABHr5jde6JoBAwdY6RhiuLlcs3Wzm1C71cQykB-awqEw/exec/presence/status?user_id={{mahasiswa_id}}&course_id={{course_id}}&session_id={{session_id}}",
							"protocol": "https",
							"host": [ "script", "google", "com" ],
							"path": [ "macros", "s", "AKfycbzwGB2egCMblZrIQUQJketAhlABHr5jde6JoBAwdY6RhiuLlcs3Wzm1C71cQykB-awqEw", "exec", "presence", "status" ],
							"query": [
								{ "key": "user_id", "value": "{{mahasiswa_id}}" },
								{ "key": "course_id", "value": "{{course_id}}" },
								{ "key": "session_id", "value": "{{session_id}}" }
							]
						}
					}
				}
			]
		},
		{
			"name": "Modul 03 - GPS Tracking",
			"item": [
				{
					"name": "POST Log GPS",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "text/plain" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"ts\": \"2026-03-03T10:15:30Z\",\n  \"lat\": -7.2575,\n  \"lng\": 112.7521,\n  \"accuracy_m\": 12.5\n}"
						},
						"url": {
							"raw": "https://script.google.com/macros/s/AKfycbzwGB2egCMblZrIQUQJketAhlABHr5jde6JoBAwdY6RhiuLlcs3Wzm1C71cQykB-awqEw/exec/telemetry/gps",
							"protocol": "https",
							"host": [ "script", "google", "com" ],
							"path": [ "macros", "s", "AKfycbzwGB2egCMblZrIQUQJketAhlABHr5jde6JoBAwdY6RhiuLlcs3Wzm1C71cQykB-awqEw", "exec", "telemetry", "gps" ]
						}
					}
				}
			]
		}
	]
}