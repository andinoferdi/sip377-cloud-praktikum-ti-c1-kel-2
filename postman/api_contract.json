{
  "info": {
    "name": "API Contract Simple v1 - Praktik Komputasi Awan",
    "description": "Collection resmi mengikuti kontrak aktif GAS berbasis query path.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Modul 01 - Presensi QR",
      "item": [
        {
          "name": "POST Generate QR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Envelope has ok', function () { pm.expect(json).to.have.property('ok'); });",
                  "if (json.ok && json.data && json.data.qr_token) { pm.environment.set('qr_token', json.data.qr_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain;charset=UTF-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": \"{{course_id}}\",\n  \"session_id\": \"{{session_id}}\",\n  \"meeting_no\": 1,\n  \"owner_identifier\": \"{{owner_identifier}}\",\n  \"ts\": \"2026-04-01T10:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}?path=presence/qr/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "presence/qr/generate"
                }
              ]
            }
          }
        },
        {
          "name": "POST Check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain;charset=UTF-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{mahasiswa_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"course_id\": \"{{course_id}}\",\n  \"session_id\": \"{{session_id}}\",\n  \"qr_token\": \"{{qr_token}}\",\n  \"ts\": \"2026-04-01T10:05:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}?path=presence/checkin",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "presence/checkin"
                }
              ]
            }
          }
        },
        {
          "name": "GET Status Presensi",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}?path=presence/status&user_id={{mahasiswa_id}}&course_id={{course_id}}&session_id={{session_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "presence/status"
                },
                {
                  "key": "user_id",
                  "value": "{{mahasiswa_id}}"
                },
                {
                  "key": "course_id",
                  "value": "{{course_id}}"
                },
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "GET Presence List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}?path=presence/list&course_id={{course_id}}&session_id={{session_id}}&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "presence/list"
                },
                {
                  "key": "course_id",
                  "value": "{{course_id}}"
                },
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "POST Stop QR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain;charset=UTF-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": \"{{course_id}}\",\n  \"session_id\": \"{{session_id}}\",\n  \"owner_identifier\": \"{{owner_identifier}}\",\n  \"ts\": \"2026-04-01T10:10:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}?path=presence/qr/stop",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "presence/qr/stop"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Modul 02 - Accelerometer",
      "item": [
        {
          "name": "POST Telemetry Accel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain;charset=UTF-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"ts\": \"2026-04-01T10:15:00Z\",\n  \"samples\": [\n    {\n      \"t\": \"2026-04-01T10:14:59Z\",\n      \"x\": 0.11,\n      \"y\": 0.02,\n      \"z\": 9.76\n    },\n    {\n      \"t\": \"2026-04-01T10:15:00Z\",\n      \"x\": 0.12,\n      \"y\": 0.03,\n      \"z\": 9.75\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}?path=telemetry/accel",
