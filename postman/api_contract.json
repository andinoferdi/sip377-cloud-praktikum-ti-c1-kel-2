              ],
              "query": [
                {
                  "key": "path",
                  "value": "telemetry/accel/history"
                },
                {
                  "key": "device_id",
                  "value": "{{device_id}}"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        }
      ]
    },
    {
